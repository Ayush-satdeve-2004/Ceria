{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ceria-evev.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://ceria-evev.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!api|uploads|assets|logo.png|manifest.json|service-worker.js|favicon.ico|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
